---
import Base from '../layouts/Base.astro';
---
<Base titulo={"Administração do catálogo | Capim Urbano"} pagina="admin" admin>
  <p id="admin-carregando" class="wrap table-state" role="status">Carregando…</p>

  <section class="admin-entrada" id="area-login" hidden>
    <form id="form-login" class="admin-cartao-login" novalidate aria-labelledby="login-titulo">
      <img class="admin-cartao-logo" src="imagens/marca/logo-sobre-papel.webp" alt="" width="708" height="459">
      <p class="hero-script" aria-hidden="true">painel do ateliê</p>
      <h1 id="login-titulo">Entrar</h1>
      <p class="admin-cartao-nota">Área restrita à administradora. O que for salvo aqui aparece no catálogo para todos os clientes.</p>
      <div class="field" data-campo="email"><label for="l-email">E-mail</label><input id="l-email" name="email" type="email" autocomplete="username" required><p class="field-error" role="alert" hidden></p></div>
      <div class="field" data-campo="senha"><label for="l-senha">Senha</label><input id="l-senha" name="senha" type="password" autocomplete="current-password" required><p class="field-error" role="alert" hidden></p></div>
      <p id="login-status" class="admin-status" role="status" aria-live="polite"></p>
      <button class="button button-dark admin-entrar" type="submit" id="entrar">Entrar</button>
    </form>
  </section>

  <section class="admin-painel" id="area-admin" hidden>
    <div class="wrap">
      <header class="admin-topo">
        <div>
          <p class="hero-script" aria-hidden="true">painel do ateliê</p>
          <h1>Produtos do <em>catálogo</em></h1>
          <p id="admin-resumo" class="admin-resumo" aria-live="polite"></p>
        </div>
        <nav class="admin-atalhos" aria-label="Ações do painel">
          <a class="button button-light button-pequeno" href="catalogo.html" target="_blank" rel="noopener">Ver como o cliente vê</a>
          <button class="button button-light button-pequeno" type="button" id="exportar">Baixar cópia (JSON)</button>
          <button class="button button-light button-pequeno" type="button" id="sair">Sair</button>
        </nav>
      </header>

      <div class="admin-layout">
        <div class="admin-lista">
          <div class="admin-ferramentas">
            <button class="button button-dark" type="button" id="novo">Novo produto</button>
            <div class="field admin-busca"><label for="busca">Buscar produto</label><input id="busca" type="search" placeholder="Nome ou categoria" autocomplete="off"></div>
          </div>
          <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>
          <div class="table-wrap">
            <table class="admin-table">
              <caption class="sr-only">Produtos cadastrados</caption>
              <thead><tr><th scope="col">Produto</th><th scope="col">Preço</th><th scope="col">Disponibilidade</th><th scope="col">No catálogo</th><th scope="col">Ações</th></tr></thead>
              <tbody id="tabela"><tr><td colspan="5" class="table-state">Carregando produtos…</td></tr></tbody>
            </table>
          </div>
        </div>

        <form id="form-produto" class="admin-form" novalidate aria-labelledby="form-titulo">
          <div class="admin-form-topo">
            <h2 id="form-titulo">Novo produto</h2>
            <p class="admin-form-dica">Campos com <span aria-hidden="true">*</span><span class="sr-only">asterisco</span> são obrigatórios.</p>
          </div>
          <input type="hidden" name="id">

          <fieldset class="admin-grupo">
            <legend>Identificação</legend>
            <div class="field" data-campo="nome"><label for="a-nome">Nome <span class="req" aria-hidden="true">*</span></label><input id="a-nome" name="nome" type="text" required><p class="field-error" role="alert" hidden></p></div>
            <div class="field" data-campo="categoria"><label for="a-cat">Categoria <span class="req" aria-hidden="true">*</span></label><input id="a-cat" name="categoria" type="text" required placeholder="Ex.: Vasos"><p class="field-error" role="alert" hidden></p></div>
            <div class="field" data-campo="descricao"><label for="a-desc">Descrição <span class="req" aria-hidden="true">*</span></label><textarea id="a-desc" name="descricao" rows="3" required></textarea><p class="field-error" role="alert" hidden></p></div>
          </fieldset>

          <fieldset class="admin-grupo">
            <legend>Fotos</legend>
            <ul class="admin-previas" id="previas" aria-label="Prévia das fotos"></ul>
            <div class="field admin-envio" data-campo="arquivos">
              <label for="a-arquivos">Enviar fotos novas</label>
              <div class="admin-arquivo">
                <input id="a-arquivos" class="admin-arquivo-input" name="arquivos" type="file" accept="image/webp,image/jpeg,image/png" multiple aria-describedby="arquivos-dica">
                <span class="button button-light button-pequeno" aria-hidden="true">Escolher fotos</span>
                <span class="admin-arquivo-nomes" id="arquivos-nomes">Nenhuma foto escolhida</span>
              </div>
              <p class="hint" id="arquivos-dica">WebP, JPEG ou PNG, até 2 MB cada. A primeira foto é a capa.</p>
              <p class="field-error" role="alert" hidden></p>
            </div>
            <div class="field" data-campo="fotos"><label for="a-fotos">Fotos já cadastradas (um caminho ou link por linha)</label><textarea id="a-fotos" name="fotos" rows="2" placeholder="imagens/web/capim5.webp"></textarea><p class="field-error" role="alert" hidden></p></div>
          </fieldset>

          <fieldset class="admin-grupo">
            <legend>Preço e prazo</legend>
            <div class="admin-duas">
              <div class="field" data-campo="preco"><label for="a-preco">Preço (R$)</label><input id="a-preco" name="preco" type="text" inputmode="decimal" placeholder="129,90" aria-describedby="preco-dica"><p class="hint" id="preco-dica">Vazio = sob orçamento.</p><p class="field-error" role="alert" hidden></p></div>
              <div class="field" data-campo="disponibilidade"><label for="a-disp">Disponibilidade <span class="req" aria-hidden="true">*</span></label><select id="a-disp" name="disponibilidade"></select><p class="field-error" role="alert" hidden></p></div>
            </div>
            <div class="field" data-campo="prazo"><label for="a-prazo">Prazo de produção ou entrega <span class="req" aria-hidden="true">*</span></label><input id="a-prazo" name="prazo" type="text" required placeholder="Ex.: Produção em até 5 dias úteis"><p class="field-error" role="alert" hidden></p></div>
          </fieldset>

          <fieldset class="admin-grupo">
            <legend>Detalhes</legend>
            <div class="field" data-campo="durabilidade"><label for="a-dur">Durabilidade</label><input id="a-dur" name="durabilidade" type="text"><p class="field-error" role="alert" hidden></p></div>
            <div class="field" data-campo="cuidados"><label for="a-cui">Cuidados</label><textarea id="a-cui" name="cuidados" rows="2"></textarea><p class="field-error" role="alert" hidden></p></div>
            <div class="admin-duas">
              <div class="field" data-campo="ocasioes"><label for="a-oca">Ocasiões</label><input id="a-oca" name="ocasioes" type="text" placeholder="Aniversário, Decoração" aria-describedby="virgula-dica"><p class="field-error" role="alert" hidden></p></div>
              <div class="field" data-campo="cores"><label for="a-cor">Cores</label><input id="a-cor" name="cores" type="text" placeholder="Vinho, Creme" aria-describedby="virgula-dica"><p class="field-error" role="alert" hidden></p></div>
            </div>
            <p class="hint" id="virgula-dica">Separe ocasiões e cores por vírgula. Elas alimentam os filtros do catálogo.</p>
          </fieldset>

          <fieldset class="admin-grupo">
            <legend>Publicação</legend>
            <div class="field checkbox admin-chave"><label><input type="checkbox" name="ativo" role="switch" checked> Mostrar no catálogo</label></div>
          </fieldset>

          <div class="admin-form-acoes">
            <button class="button button-dark" type="submit">Salvar produto</button>
            <button class="button button-light" type="button" id="cancelar">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </section>
  <script>import '../scripts/admin.js';</script>
</Base>
