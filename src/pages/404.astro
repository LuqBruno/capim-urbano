---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada | Capim Urbano" erro404>
  <section class="pt-[clamp(56px,9vw,120px)] pb-[clamp(48px,6vw,80px)]">
    <div class="wrap grid grid-cols-[minmax(0,1.25fr)_minmax(0,.75fr)] items-end gap-[clamp(32px,6vw,96px)] max-820:grid-cols-1">
      <div>
        <h1 class="mb-0 text-[clamp(2.9rem,6.2vw,5.4rem)]">Essa página <em>não está por aqui.</em></h1>
        <p class="lead">O endereço pode ter mudado ou ter sido digitado de outro jeito. Volte ao início ou veja o catálogo de flores desidratadas.</p>
        <div class="actions">
          <a class="button button-dark" href="index.html">Voltar ao início</a>
          <a class="button button-light" href="catalogo.html">Ver o catálogo</a>
        </div>
      </div>
      <div class="ficha-404" aria-hidden="true">
        <img src="imagens/botanico-02.png" alt="" width="74" height="99">
        <strong>Nº 404</strong>
        <span>espécime não catalogado</span>
      </div>
    </div>
  </section>
</Base>
