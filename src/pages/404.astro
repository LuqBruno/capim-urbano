---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada | Capim Urbano" erro404>
  <section class="page-hero">
    <div class="wrap">
      <h1>Essa página <em>não está por aqui.</em></h1>
      <p class="lead">O endereço pode ter mudado ou ter sido digitado de outro jeito. Volte ao início ou veja o catálogo de flores desidratadas.</p>
      <div class="actions">
        <a class="button button-dark" href="index.html">Voltar ao início</a>
        <a class="button button-light" href="catalogo.html">Ver o catálogo</a>
      </div>
    </div>
  </section>
</Base>
