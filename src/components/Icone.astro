---
// Ícones de traço usados no site (decorativos: aria-hidden). Mantém o markup idêntico ao antigo SVG inline.
interface Props { nome: 'seta' | 'seta-diagonal' | 'whatsapp' | 'instagram' | 'local'; }
const { nome } = Astro.props;
---
{nome === 'seta-diagonal' && (
  <svg class="icon icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
)}
{nome === 'seta' && (
  <svg class="icon icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
)}
{nome === 'whatsapp' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5l1.2-3.7A8 8 0 1 1 8.6 18.6z"/><path d="M9.2 8.6c.2 2.8 3 5.6 5.9 5.9l1-1.3-1.9-1-1 .7a5 5 0 0 1-2.4-2.4l.7-1-1-1.9z"/></svg>
)}
{nome === 'instagram' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg>
)}
{nome === 'local' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
)}
