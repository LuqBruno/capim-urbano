---
import Icone from './Icone.astro';
import { WHATSAPP } from '../lib/catalogo-core.js';
// "whatsapp" é a mensagem inicial do link de WhatsApp do rodapé (muda por página).
const { whatsapp } = Astro.props;
---
<footer class="site-footer">
  <div class="carimbo" aria-hidden="true">
    <svg viewBox="0 0 120 120" focusable="false">
      <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1.6" />
      <circle cx="60" cy="60" r="38.5" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
      <path id="carimbo-trilha" d="M60 60m-47.5 0a47.5 47.5 0 1 1 95 0a47.5 47.5 0 1 1-95 0" fill="none" />
      <text textLength="296" lengthAdjust="spacing"><textPath href="#carimbo-trilha">Herbário Capim Urbano · Tubarão · SC · </textPath></text>
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 80V43" />
        <path d="M60 62c-8-1-13-6-15-13 7 0 13 5 15 13z" />
        <path d="M60 56c8-1 13-6 15-13-7 0-13 5-15 13z" />
        <path d="M60 72c-7-1-11-5-12-11 6 0 10 4 12 11z" />
        <path d="M60 67c7-1 11-5 12-11-6 0-10 4-12 11z" />
      </g>
    </svg>
  </div>
  <div class="wrap footer-inner">
    <div>
      <a class="brand-mark" href="index.html" aria-label="Capim Urbano, página inicial"><img src="imagens/marca/logo-sobre-salvia.webp" alt="" width="708" height="459" loading="lazy"></a>
      <p>Flores desidratadas em composições autorais, criadas em Tubarão, Santa Catarina. <em>Plantar beleza, colher alegria.</em></p>
    </div>
    <div>
      <p class="footer-title">Serviços</p>
      <ul class="footer-list">
        <li><a href="catalogo.html">Catálogo</a></li>
        <li><a href="assinatura-floral.html">Assinatura floral</a></li>
        <li><a href="eternizacao-de-flores.html">Eternização de flores</a></li>
        <li><a href="oficinas-florais.html">Oficinas florais</a></li>
        <li><a href="arranjos-e-presentes.html">Arranjos &amp; presentes</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-title">Conversar</p>
      <ul class="footer-list">
        <li><a href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(whatsapp)}`} target="_blank" rel="noopener"><Icone nome="whatsapp" /> WhatsApp (48) 99176-5295</a></li>
        <li><a href="https://www.instagram.com/capimurbano.ateliefloral/" target="_blank" rel="noopener"><Icone nome="instagram" /> @capimurbano.ateliefloral</a></li>
        <li><a href="contato.html"><Icone nome="local" /> Tubarão · SC</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base"><span>© <span data-year>2026</span> Capim Urbano Ateliê Floral</span><span>Feito com carinho, flor por flor.</span></div>
</footer>
