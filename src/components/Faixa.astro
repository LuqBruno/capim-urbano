---
// Faixa de etiquetas que desliza devagar (como as etiquetas de uma coleção). Decorativa: os serviços
// aparecem como links logo abaixo. A lista é repetida duas vezes para o deslize não ter emenda.
const itens = ['Assinatura floral', 'Eternização de flores', 'Oficinas florais', 'Arranjos & presentes', 'Flores que habitam o tempo'];
---
<div class="faixa" aria-hidden="true">
  <div class="faixa-trilho">
    {[0, 1].map(() => itens.map((t) => (
      <span class="faixa-item">{t}<svg class="faixa-flor" viewBox="0 0 20 20"><ellipse cx="10" cy="5" rx="2.6" ry="5" /><ellipse cx="10" cy="5" rx="2.6" ry="5" transform="rotate(72 10 10)" /><ellipse cx="10" cy="5" rx="2.6" ry="5" transform="rotate(144 10 10)" /><ellipse cx="10" cy="5" rx="2.6" ry="5" transform="rotate(216 10 10)" /><ellipse cx="10" cy="5" rx="2.6" ry="5" transform="rotate(288 10 10)" /></svg></span>
    )))}
  </div>
</div>
