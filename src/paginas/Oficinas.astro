---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Icone from '../components/Icone.astro';
import Migalhas from '../components/Migalhas.astro';
import Passos from '../components/Passos.astro';
import Chamada from '../components/Chamada.astro';
import { linguaValida } from '../i18n/interface.js';
import { siteDe } from '../i18n/site.js';
import { raizDe, linkWhatsApp } from '../i18n/rotas.js';
const lingua = linguaValida(Astro.props.lingua);
const s = siteDe(lingua);
const t = s.oficinas;
const c = s.comum;
const r = raizDe(lingua);
const galeria = [['oficina-hero.webp', 1254, 1254, 'row-span-2 max-820:col-span-full max-820:row-auto max-820:aspect-[4/3]'], ['oficina-acao.webp', 1254, 1254], ['oficina-presente-vivo.webp', 1350, 1800]];
const formatos = [['oficina-arranjo-180.webp', 1350, 1800], ['oficina-guirlanda.webp', 960, 1194], ['oficina-arranjo-vaso.webp', 1080, 1350], ['oficina-escapularios.webp', 960, 1106]];
---
<Base titulo={t.titulo} descricao={t.descricao} og atual="oficinas" whatsapp={c.whatsapp.oficina} lingua={lingua} arquivo="oficinas-florais.html">
  <Topo titulo={t.h1} nota={t.nota}>
    <Migalhas slot="migalhas" atual={t.migalha} lingua={lingua} />
    <div slot="nota" class="actions mt-[22px]"><a class="button button-dark" href={linkWhatsApp(c.whatsapp.oficina)} target="_blank" rel="noopener"><Icone nome="whatsapp" /> {t.organizar}</a><a class="text-link" href="#formatos">{t.verFormatos} <Icone nome="seta" /></a></div>
  </Topo>
  <section class="section pt-0" aria-label={t.galeria}>
    <div class="wrap gallery">
      {galeria.map(([arquivo, largura, altura, classe], i) => <figure class:list={[classe, 'reveal-img']}><img src={r + 'imagens/web/' + arquivo} alt={t.galeriaAlts[i]} width={largura} height={altura} loading="lazy"></figure>)}
    </div>
  </section>
  <section class="section relative pt-0 text-center">
    <div class="wrap reveal"><p class="quote" set:html={t.frase} /></div>
  </section>
  <section class="section pt-0">
    <div class="wrap">
      <div class="reveal mb-[clamp(40px,5vw,72px)] max-w-[40rem]"><h2 set:html={t.publicosTitulo} /></div>
      <div class="grid grid-cols-3 gap-[clamp(24px,4vw,56px)] max-820:grid-cols-1">
        {t.publicos.map(([h, p], i) => <article class="reveal border-t border-line-strong pt-[26px]" style={i ? `--d:${i * 100}ms` : undefined}><h3 class="text-[1.8rem]">{h}</h3><p class="text-[.97rem] text-muted">{p}</p></article>)}
      </div>
    </div>
  </section>
  <section class="night section">
    <img class="night-sprig" src={r + 'imagens/botanico-01.png'} alt="" aria-hidden="true" width="260" height="347" loading="lazy">
    <div class="wrap grid grid-cols-2 items-center gap-[clamp(32px,7vw,112px)] max-820:grid-cols-1">
      <div class="reveal"><h2 set:html={t.beneficiosTitulo} /><p>{t.beneficiosTexto}</p></div>
      <ul class="reveal m-0 grid list-none grid-cols-2 gap-x-[clamp(24px,4vw,56px)] gap-y-0 p-0 max-820:grid-cols-1" style="--d:120ms">{t.beneficios.map((b) => <li class="flex items-baseline gap-4 border-b border-[rgba(233,229,218,.16)] py-[18px] text-night-text before:h-px before:w-[14px] before:flex-none before:-translate-y-1 before:bg-[#d8d3c4] before:content-['']">{b}</li>)}</ul>
    </div>
  </section>
  <section class="section" id="formatos">
    <div class="wrap">
      <div class="reveal mb-[clamp(40px,5vw,72px)] max-w-[40rem]"><h2 set:html={t.formatosTitulo} /></div>
      <div class="grid grid-cols-4 gap-[14px] max-1080:grid-cols-2 max-520:gap-3">{formatos.map(([arquivo, largura, altura], i) => <figure class="group reveal m-0" style={`--d:${i * 90}ms`}><div class="overflow-hidden rounded-lg bg-paper-3"><img class="aspect-[4/5] w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-104" src={r + 'imagens/web/' + arquivo} alt={t.formatos[i][1]} width={largura} height={altura} loading="lazy"></div><figcaption class="pt-4 font-serif text-[1.5rem] leading-[1.15] text-ink max-520:text-[1.2rem]">{t.formatos[i][0]}</figcaption></figure>)}</div>
    </div>
  </section>
  <Passos titulo={t.passosTitulo} passos={t.passos} nota={t.passosNota} />
  <section class="section pt-0">
    <div class="wrap grid grid-cols-2 items-center gap-[clamp(32px,7vw,112px)] max-820:grid-cols-1">
      <figure class="split-media reveal-img"><img src={r + 'imagens/web/juliana-luque-oficina.webp'} alt={t.conduzAlt} width="1200" height="1800" loading="lazy"></figure>
      <div class="reveal [&_p]:max-w-[34rem] [&_p]:text-muted">
        <h2 set:html={t.conduzTitulo} />
        {t.conduzTexto.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>
  <Chamada titulo={t.ctaTitulo} texto={t.ctaLead} botao={t.ctaBotao} mensagem={c.whatsapp.oficina} lingua={lingua} />
</Base>
