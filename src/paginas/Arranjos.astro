---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Migalhas from '../components/Migalhas.astro';
import Passos from '../components/Passos.astro';
import Chamada from '../components/Chamada.astro';
import { linguaValida } from '../i18n/interface.js';
import { siteDe } from '../i18n/site.js';
import { raizDe } from '../i18n/rotas.js';
const lingua = linguaValida(Astro.props.lingua);
const s = siteDe(lingua);
const t = s.arranjos;
const c = s.comum;
const r = raizDe(lingua);
const galeria = [['capim6.webp', 1200, 1600, 'row-span-2 max-820:col-span-full max-820:row-auto max-820:aspect-[4/3]'], ['capim4.webp', 1200, 1600], ['capim5.webp', 1200, 1600]];
---
<Base titulo={t.titulo} descricao={t.descricao} og atual="arranjos" whatsapp={c.whatsapp.encomenda} lingua={lingua} arquivo="arranjos-e-presentes.html">
  <Topo titulo={t.h1} nota={t.nota}>
    <Migalhas slot="migalhas" atual={c.servicos.arranjos} lingua={lingua} />
  </Topo>
  <section class="section pt-0">
    <div class="wrap gallery">
      {galeria.map(([arquivo, largura, altura, classe], i) => <figure class:list={[classe, 'reveal-img']}><img src={r + 'imagens/web/' + arquivo} alt={t.galeriaAlts[i]} width={largura} height={altura} loading="lazy"></figure>)}
    </div>
  </section>
  <section class="section pt-0">
    <div class="wrap grid grid-cols-2 items-center gap-[clamp(32px,7vw,112px)] max-820:grid-cols-1">
      <div class="reveal [&_p]:max-w-[34rem] [&_p]:text-muted">
        <h2 set:html={t.h2} />
        {t.texto.map((p) => <p>{p}</p>)}
        <ul class="chips">{t.chips.map((x) => <li>{x}</li>)}</ul>
      </div>
      <figure class="split-media reveal-img"><img src={r + 'imagens/web/oficina-presente-vivo.webp'} alt={t.fotoAlt} width="1350" height="1800" loading="lazy"></figure>
    </div>
  </section>
  <Passos titulo={t.passosTitulo} passos={t.passos} nota={t.passosNota} />
  <Chamada titulo={t.ctaTitulo} texto={t.ctaLead} botao={t.ctaBotao} mensagem={c.whatsapp.encomenda} lingua={lingua} />
</Base>
