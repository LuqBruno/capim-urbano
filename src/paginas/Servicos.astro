---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Icone from '../components/Icone.astro';
import Passos from '../components/Passos.astro';
import Chamada from '../components/Chamada.astro';
import { linguaValida } from '../i18n/interface.js';
import { siteDe } from '../i18n/site.js';
import { raizDe } from '../i18n/rotas.js';
const lingua = linguaValida(Astro.props.lingua);
const s = siteDe(lingua);
const t = s.servicos;
const c = s.comum;
const r = raizDe(lingua);
const itens = [
  ['assinatura', 'assinatura-floral.html', 'capim5.webp'],
  ['eternizacao', 'eternizacao-de-flores.html', 'capim2.webp'],
  ['oficinas', 'oficinas-florais.html', 'oficina-hero.webp'],
  ['arranjos', 'arranjos-e-presentes.html', 'capim6.webp']
];
---
<Base titulo={t.titulo} descricao={t.descricao} og atual="servicos" whatsapp={c.whatsapp.servico} lingua={lingua} arquivo="servicos.html">
  <Topo titulo={t.h1} nota={t.nota} />
  <section class="section pt-0">
    <div class="wrap"><ul class="service-index" aria-label={t.indice}>{itens.map(([chave, href, foto], i) => <li class="reveal" style={`--d:${i * 80}ms`}><a href={href}><img src={r + 'imagens/web/' + foto} alt="" width="120" height="150" loading="lazy"><div><h2>{c.servicos[chave]}</h2><p>{t.itens[chave]}</p></div><span class="round" aria-hidden="true"><Icone nome="seta" /></span></a></li>)}</ul></div>
  </section>
  <Passos titulo={t.passosTitulo} passos={t.passos} />
  <Chamada titulo={t.ctaTitulo} texto={t.ctaLead} mensagem={c.whatsapp.qualServico} lingua={lingua} />
</Base>
