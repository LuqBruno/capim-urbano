---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Varal from '../components/Varal.astro';
import Chamada from '../components/Chamada.astro';
import { linguaValida } from '../i18n/interface.js';
import { siteDe } from '../i18n/site.js';
import { fonte, foco, menor } from '../lib/fotos.js';
import { raizDe, linkWhatsApp, INSTAGRAM } from '../i18n/rotas.js';
const lingua = linguaValida(Astro.props.lingua);
const s = siteDe(lingua);
const t = s.inicio;
const c = s.comum;
const r = raizDe(lingua);
const conversa = linkWhatsApp(c.whatsapp.servico);
const fotosVaral = [
  ['presentes-cone-floral.webp', 1086, 1448], ['oficinas-detalhe-materiais.webp', 900, 1600], ['eternizacao-cavalete-colorido.webp', 1200, 1600], ['capim5.webp', 1200, 1600],
  ['oficina-guirlanda.webp', 960, 1194], ['oficinas-grupo-final.webp', 1600, 1200], ['oficina-arranjo-180.webp', 1350, 1800], ['oficina-escapularios.webp', 960, 1106]
].map(([arquivo, largura, altura], i) => ({ src: r + 'imagens/web/' + menor(arquivo), largura, altura, titulo: t.varal[i][0], legenda: t.varal[i][1], alt: t.varal[i][2] }));
const sv = t.servicos;
const servicos = [
  { chave: 'assinatura', href: 'assinatura-floral.html', foto: ['presentes-garrafinha-alegria.webp', 1086, 1448, '50% 92%', '50% 92%'] },
  { chave: 'eternizacao', href: 'eternizacao-de-flores.html', foto: ['eternizacao-principal.webp', 1200, 1600, '48% 68%', '48% 72%'] },
  { chave: 'oficinas', href: 'oficinas-florais.html', foto: ['oficinas-mesa-criativa.webp', 900, 1600, '50% 42%', '50% 36%'] },
  { chave: 'arranjos', href: 'arranjos-e-presentes.html' }
];
const presentes = [['presentes-box-afeto.webp', 1086, 1448], ['presentes-buque-petit.webp', 1086, 1448], ['presentes-arranjo-vinho.webp', 1086, 1448]];
---
<Base titulo={t.titulo} descricao={t.descricao} og desperta atual="inicio" whatsapp={c.whatsapp.servico} lingua={lingua} arquivo="index.html">
  <section class="hero-cena" data-hero aria-labelledby="hero-titulo">
    <div class="hero-palco">
      <div class="wrap hero-grade">
        <div class="hero-texto">
          <p class="hero-script hero-entra" style="--i:0">{t.lema}</p>
          <h1 id="hero-titulo"><span class="block hero-entra" style="--i:1">{t.linha1}</span> <span class="block hero-entra" style="--i:2" set:html={t.linha2} /></h1>
          <p class="lead hero-entra" style="--i:3">{t.lead}</p>
          <div class="actions hero-entra" style="--i:4"><a class="button button-dark" href="servicos.html">{t.conhecer} <Icone nome="seta" /></a><a class="text-link" href={conversa} target="_blank" rel="noopener">{t.falar} <Icone nome="seta-diagonal" /></a></div>
        </div>
        <div class="hero-alvo">
          <figure class="hero-janela">
            <div class="hero-foto"><img src={r + 'imagens/web/capim1.webp'} alt={t.heroAlt} width="1600" height="1066" fetchpriority="high"></div>
            <figcaption class="hero-tag"><strong>{t.selo}</strong>{t.seloTexto}</figcaption>
          </figure>
        </div>
      </div>
      <canvas class="hero-capim" aria-hidden="true"></canvas>
      <p class="hero-rolar" aria-hidden="true"><span>{t.rolar}</span></p>
    </div>
  </section>

  <section class="section relative pt-[clamp(48px,6vw,88px)] text-center">
    <div class="wrap reveal">
      <img class="sprig" src={r + 'imagens/botanico-02.png'} alt="" aria-hidden="true" width="74" height="99" loading="lazy">
      <p class="quote" set:html={t.manifesto} />
      <p class="mt-[34px] mb-0 text-[.95rem] text-muted">{t.fundadora}</p>
    </div>
  </section>

  <section class="section pt-0" id="servicos">
    <div class="wrap">
      <div class="reveal mb-[clamp(48px,7vw,96px)] grid grid-cols-[minmax(0,1.1fr)_minmax(0,.9fr)] items-end gap-10 max-820:grid-cols-1">
        <h2 class="mb-0" set:html={t.servicosTitulo} />
        <p class="lead mb-[6px]">{t.servicosLead}</p>
      </div>

      {servicos.map(({ chave, href, foto }, i) => {
        const d = sv[chave];
        const lado = i % 2 ? 'order-2 max-820:order-none' : '';
        return (
          <article class:list={['service grid grid-cols-2 items-center gap-[clamp(32px,7vw,112px)] py-[clamp(32px,4.6vw,64px)] max-820:grid-cols-1', i > 0 && 'border-t border-line']}>
            {foto ? (
              <figure class:list={['service-media reveal-img', lado]}><img src={r + 'imagens/web/' + foto[0]} {...fonte(r, foto[0], foto[1], '(max-width: 820px) 92vw, 44vw')} alt={d.alt} width={foto[1]} height={foto[2]} loading="lazy" style={foco(foto[3], foto[4])}></figure>
            ) : (
              <div class:list={['gift-strip gift-strip-pecas service-media rounded-none bg-transparent shadow-none', lado]}>
                {presentes.map(([arquivo, largura, altura], j) => <figure class="reveal-img" style={j === 1 ? '--d:120ms' : undefined}><img src={r + 'imagens/web/' + arquivo} {...fonte(r, arquivo, largura, '(max-width: 820px) 92vw, 16vw')} alt={d.alts[j]} width={largura} height={altura} loading="lazy"></figure>)}
              </div>
            )}
            <div class="reveal max-w-[31rem]">
              <p class="mt-0 mb-[18px] font-serif text-[1.25rem] text-olive italic">{d.para}</p>
              <h3 class="text-[clamp(2.3rem,4vw,3.4rem)] leading-[1.02]">{c.servicos[chave]}</h3>
              <p class="text-muted">{d.texto}</p>
              <ul class="mt-[26px] mb-[34px] grid list-none gap-[10px] p-0">{d.pontos.map((p) => <li class="flex items-baseline gap-[14px] text-[.96rem] text-graphite before:h-px before:w-[14px] before:flex-none before:-translate-y-1 before:bg-acento before:content-['']">{p}</li>)}</ul>
              <a class="text-link" href={href}>{d.link} <Icone nome="seta" /></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="night section">
    <img class="night-sprig" src={r + 'imagens/botanico-01.png'} alt="" aria-hidden="true" width="260" height="347" loading="lazy">
    <div class="wrap grid grid-cols-[minmax(0,.8fr)_minmax(0,1fr)] items-center gap-[clamp(36px,7vw,110px)] max-820:grid-cols-1">
      <figure class="atelier-photo reveal-img"><img src={r + 'imagens/web/juliana-luque-oficina.webp'} alt={t.atelieAlt} width="1200" height="1800" loading="lazy"></figure>
      <div class="reveal [&_p]:max-w-[33rem]">
        <h2 set:html={t.atelieTitulo} />
        {t.atelieTexto.map((p) => <p>{p}</p>)}
        <p class="mt-11 mb-0 font-serif text-[clamp(1.9rem,3vw,2.5rem)] leading-[1.1] italic"><Fragment set:html={t.atelieAssinatura} /><small class="mt-[14px] block font-sans text-[.9rem] text-night-muted not-italic">{t.fundadora}</small></p>
      </div>
    </div>
  </section>

  <section class="section varal-secao" aria-labelledby="insta-titulo">
    <div class="wrap reveal grid grid-cols-[minmax(0,1.1fr)_minmax(0,.9fr)] items-end gap-x-[clamp(32px,6vw,96px)] gap-y-4 max-820:grid-cols-1">
      <h2 id="insta-titulo" class="mb-0" set:html={t.instaTitulo} />
      <div>
        <p class="lead mb-3">{t.instaLead}</p>
        <a class="inline-flex min-h-11 items-center gap-3 font-medium text-acento no-underline hover:underline [&_.icon]:size-[1.05em]" href={INSTAGRAM} target="_blank" rel="noopener"><Icone nome="instagram" /> @capimurbano.ateliefloral</a>
      </div>
    </div>
    <p class="wrap varal-dica">{t.varalLead}</p>
    <Varal rotulo={t.varalRotulo} lingua={lingua} fotos={fotosVaral} largura={200} cede={22} autoplay={0} />
  </section>

  <Chamada titulo={t.ctaTitulo} texto={t.ctaLead} mensagem={c.whatsapp.servico} lingua={lingua} />
  <script>import '../scripts/hero.js';</script>
</Base>
