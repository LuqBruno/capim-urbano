---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Migalhas from '../components/Migalhas.astro';
import Passos from '../components/Passos.astro';
import Chamada from '../components/Chamada.astro';
import { linguaValida } from '../i18n/interface.js';
import { siteDe } from '../i18n/site.js';
import { raizDe } from '../i18n/rotas.js';
const lingua = linguaValida(Astro.props.lingua);
const s = siteDe(lingua);
const t = s.eternizacao;
const c = s.comum;
const r = raizDe(lingua);
---
<Base titulo={t.titulo} descricao={t.descricao} og atual="eternizacao" whatsapp={c.whatsapp.eternizacao} lingua={lingua} arquivo="eternizacao-de-flores.html">
  <Topo titulo={t.h1} nota={t.nota}>
    <Migalhas slot="migalhas" atual={t.migalha} lingua={lingua} />
  </Topo>
  <section class="section pt-0">
    <div class="wrap grid grid-cols-2 items-center gap-[clamp(32px,7vw,112px)] max-820:grid-cols-1">
      <figure class="split-media reveal-img order-2 max-820:order-none"><img src={r + 'imagens/web/capim2.webp'} alt={t.fotoAlt} width="1600" height="2400" loading="lazy"></figure>
      <div class="reveal [&_p]:max-w-[34rem] [&_p]:text-muted">
        <h2 set:html={t.h2} />
        {t.texto.map((p) => <p>{p}</p>)}
        <ul class="chips">{t.chips.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>
  <Passos titulo={t.passosTitulo} passos={t.passos} />
  <Chamada titulo={t.ctaTitulo} texto={t.ctaLead} botao={t.ctaBotao} mensagem={c.whatsapp.eternizacao} lingua={lingua} />
</Base>
