---
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descricao?: string;
  /** Inclui as tags Open Graph (páginas do site institucional). */
  og?: boolean;
  /** Valor de data-page: o script da página usa para saber o que montar. */
  pagina?: string;
  /** Rótulo do item do menu marcado como página atual. */
  atual?: string;
  /** Mensagem inicial do WhatsApp no rodapé. */
  whatsapp?: string;
  /** Administração: cabeçalho simples, sem rodapé, sem animações e fora dos buscadores. */
  admin?: boolean;
  /** Página de erro 404: serve em qualquer caminho, então fixa a base dos links relativos e sai dos buscadores. */
  erro404?: boolean;
}
const { titulo, descricao, og = false, pagina, atual, whatsapp = '', admin = false, erro404 = false } = Astro.props;

// Endereços absolutos (compartilhamento e buscadores) só existem na publicação, quando SITE_URL está definido.
const raiz = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const absoluta = (caminho: string) => (Astro.site ? new URL(raiz + caminho, Astro.site).href : caminho);
const canonica = Astro.site && !admin && !erro404
  ? new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site).href
  : undefined;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {erro404 && <base href={raiz} />}
  <title>{titulo}</title>
  {descricao && <meta name="description" content={descricao} />}
  {(admin || erro404) && <meta name="robots" content="noindex, nofollow" />}
  {canonica && <link rel="canonical" href={canonica} />}
  <meta name="theme-color" content="#f4f1ea">
  {og && <>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="Capim Urbano Ateliê Floral">
    <meta property="og:title" content={titulo}>
    <meta property="og:description" content={descricao}>
    <meta property="og:image" content={absoluta('imagens/web/og.jpg')}>
    {canonica && <meta property="og:url" content={canonica} />}
    <meta name="twitter:card" content="summary_large_image">
  </>}
  <link rel="icon" href="imagens/web/capimlogo.webp" type="image/webp">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&family=Quicksand:wght@400;500;600&display=swap" rel="stylesheet">
  {!admin && <script is:inline>document.documentElement.classList.add('js')</script>}
</head>
<body data-page={pagina}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {admin ? (
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand-mark" href="index.html" aria-label="Capim Urbano, página inicial"><img src="imagens/marca/logo-sobre-papel.webp" alt="" width="708" height="459"></a>
        <nav class="site-nav" aria-label="Navegação"><a href="catalogo.html">Ver catálogo</a></nav>
      </div>
    </header>
  ) : (
    <>
      <div class="scroll-progress" aria-hidden="true"></div>
      <Header atual={atual} />
    </>
  )}
  <main id="conteudo">
    <slot />
  </main>
  {!admin && <Footer whatsapp={whatsapp} />}
  {!admin && <script>import '../scripts/site.js';</script>}
</body>
</html>
